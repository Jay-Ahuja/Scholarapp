# Anthropic API key — used for resume parsing, project matching, and email drafting.
ANTHROPIC_API_KEY=

# Tavily Search API key — used to resolve professor faculty pages and emails.
TAVILY_API_KEY=

# Master switch for actually sending email. Default false. Flip to true only after
# reviewing the approved drafts. See docs/08-delivery.md for the full procedure.
SEND_ENABLED=false

# Per-day cap on emails sent. Only consulted when SEND_ENABLED=true.
SEND_DAILY_CAP=20

# Where Scholarapp stores its SQLite DB, run inputs, and (Step 8) OAuth credentials.
# Defaults to ~/.scholarapp if unset.
DATA_DIR=~/.scholarapp

# Where editable draft .md files are written. Defaults to ./drafts/ in the
# directory you run `scholar` from (visible in Finder; macOS hides DATA_DIR).
# Override if you want them somewhere specific.
# DRAFTS_DIR=

# Concurrent Anthropic calls per pipeline stage (discovery enrichment, matching,
# drafting). Default 3 is safe on Anthropic Tier 1 (50 RPM cap). Raise to 10+
# after upgrading to Tier 2 for ~3x faster runs.
ANTHROPIC_CONCURRENCY=3

# Number of times the Anthropic SDK retries 429s / 5xx / network errors per
# call. Honors Retry-After. Bump if you keep seeing transient 429 failures.
ANTHROPIC_MAX_RETRIES=5

# Hard USD spending ceiling for a single `scholar run`. When set, the run stops
# cleanly before cumulative Claude spend would exceed it (falling through to
# partial delivery). The --budget <usd> CLI flag overrides this. Unset = no ceiling.
# RUN_MAX_USD=

