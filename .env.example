# Anthropic API key — used for resume parsing, project matching, and email drafting.
ANTHROPIC_API_KEY=

# Tavily Search API key — used to resolve professor faculty pages and emails.
TAVILY_API_KEY=

# Master switch for actually sending email. Default false. Flip to true only after
# reviewing the approved drafts. See docs/08-delivery.md for the full procedure.
SEND_ENABLED=false

# Per-day cap on emails sent. Only consulted when SEND_ENABLED=true.
SEND_DAILY_CAP=20

# Where Scholarapp stores its SQLite DB, run inputs, drafts, and OAuth credentials.
# Defaults to ~/.scholarapp if unset.
DATA_DIR=~/.scholarapp
